digraph codebase {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=16, label="pi-wishcraft codebase dependency graph", labelloc=t];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=10];
  edge [color="#777777", arrowsize=0.6];

  subgraph cluster_root {
    label="root";
    style=filled;
    color=black;
    fillcolor="black22";
    n10 [label="index", fillcolor=black, fontcolor=white, tooltip="index.ts"];
  }

  subgraph cluster_config {
