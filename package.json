{
  "name": "@groeponline/pi-wishcraft",
  "version": "1.27.0",
  "description": "Pi coding agent extension: operator cockpit with a live powerline status bar, idea queue, skill search, sticky Bash, hooks, policy guardrails, and TUI session UX.",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "*.ts",
    "*.md",
    "*.json",
    "!audit-baseline.json",
    "!.oxlintrc.json",
    "banner.png",
    "docs/**/*.md",
    "src/**/*.ts",
    "src/**/*.txt",
    "bash-mode/**/*.ts",
    "queue/**/*.ts"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi",
    "wishcraft",
    "cockpit",
    "coding-agent",
    "ai-agent",
    "powerline",
    "status-bar",
    "statusline",
    "extension",
    "groeponline",
    "terminal-ui",
    "tui",
    "developer-tools",
    "agent-ui",
    "productivity",
    "hooks",
    "skills",
    "idea-queue",
    "guardrails",
    "bash-mode",
    "workflow"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "author": "GroepOnline",
  "license": "MIT",
  "homepage": "https://pi.dev/packages/@groeponline/pi-wishcraft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GroepOnline/pi-wishcraft.git"
  },
  "bugs": {
    "url": "https://github.com/GroepOnline/pi-wishcraft/issues"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests scripts index.ts bash-mode queue",
    "lint:fix": "oxlint --fix src tests scripts index.ts bash-mode queue",
    "test": "node --experimental-strip-types --experimental-test-coverage --test-coverage-lines=70 --test-coverage-functions=60 --test tests/**/*.test.ts",
    "check": "bun run typecheck && bun run lint && bun run test",
    "release": "bun scripts/release.mjs",
    "prepublishOnly": "bun run typecheck && bun run lint && bun scripts/verify-package.mjs && bun run verify:pi-package",
    "verify:package": "bun scripts/verify-package.mjs && bun scripts/verify-pi-package-contract.mjs",
    "circular": "madge --circular src index.ts bash-mode queue",
    "file-size": "bun scripts/check-file-size.mjs",
    "boundaries": "bun scripts/check-boundaries.mjs",
    "audit": "bun scripts/audit-gate.mjs",
    "preview": "bun scripts/preview.mjs",
    "verify:pi-package": "bun scripts/verify-pi-package-contract.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:integration": "node --experimental-strip-types --test tests/pi-host-rpc.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/node": "24.13.3",
    "madge": "^8.0.0",
    "oxlint": "^1.91.0",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/GroepOnline/pi-wishcraft/main/banner.png"
  }
}
