{
  "name": "@groeponline/pi-wishcraft",
  "version": "0.20.0",
  "description": "Wishcraft cockpit for the pi coding agent — powerline status, vibes, idea inbox, bash mode, and full customization.",
  "type": "module",
  "files": [
    "*.ts",
    "*.md",
    "*.json",
    "banner.png",
    "src/**/*.ts",
    "src/**/*.txt",
    "bash-mode/**/*.ts",
    "queue/**/*.ts"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi",
    "wishcraft",
    "cockpit",
    "coding-agent",
    "powerline",
    "status-bar",
    "extension"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "author": "GroepOnline",
  "license": "MIT",
  "homepage": "https://github.com/GroepOnline/pi-wishcraft#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GroepOnline/pi-wishcraft.git"
  },
  "bugs": {
    "url": "https://github.com/GroepOnline/pi-wishcraft/issues"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "tsc --noEmit && node scripts/verify-package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "circular": "madge --circular src index.ts bash-mode queue"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.81.0 <0.85.0",
    "@earendil-works/pi-coding-agent": ">=0.81.0 <0.85.0",
    "@earendil-works/pi-tui": ">=0.81.0 <0.85.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "@types/node": "24.13.3",
    "madge": "^8.0.0",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/GroepOnline/pi-wishcraft/main/banner.png"
  }
}
