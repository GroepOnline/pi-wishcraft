{
  "name": "@groeponline/pi-wishcraft",
  "version": "1.4.16",
  "description": "Operator cockpit for Pi: live powerline status, searchable skills, idea queue, sticky Bash, hooks, policy controls, and session UX.",
  "type": "module",
  "files": [
    "*.ts",
    "*.md",
    "*.json",
    "banner.png",
    "docs/**/*.md",
    "src/**/*.ts",
    "src/**/*.txt",
    "bash-mode/**/*.ts",
    "queue/**/*.ts"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi",
    "wishcraft",
    "cockpit",
    "coding-agent",
    "powerline",
    "status-bar",
    "extension",
    "groeponline",
    "terminal-ui",
    "developer-tools",
    "agent-ui",
    "productivity",
    "hooks"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "author": "GroepOnline",
  "license": "MIT",
  "homepage": "https://pi.dev/packages/@groeponline/pi-wishcraft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GroepOnline/pi-wishcraft.git"
  },
  "bugs": {
    "url": "https://github.com/GroepOnline/pi-wishcraft/issues"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "tsc --noEmit && node scripts/verify-package.mjs && npm run verify:pi-package",
    "verify:package": "node scripts/verify-package.mjs && node scripts/verify-pi-package-contract.mjs",
    "circular": "madge --circular src index.ts bash-mode queue",
    "preview": "node --experimental-strip-types scripts/preview.mjs",
    "verify:pi-package": "node scripts/verify-pi-package-contract.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.0",
    "@types/node": "24.13.3",
    "madge": "^8.0.0",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/GroepOnline/pi-wishcraft/main/banner.png"
  }
}
